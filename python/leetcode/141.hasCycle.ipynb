   "source": [
    "def hasCycle(head) -> bool:\n",
    "    a = set()\n",
    "    while head:\n",
    "        if head in a:\n",
    "            return True\n",
    "        a.add(head)\n",
    "        head = head.next\n",
    "    return False"
   ]
  }
