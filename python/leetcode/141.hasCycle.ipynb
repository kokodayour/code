   "source": [
    "def hasCycle(head):\n",
    "    fast = slow = head\n",
    "    while fast and fast.next:\n",
    "        slow = slow.next\n",
    "        fast = fast.next.next\n",
    "        if slow is fast:\n",
    "            return True\n",
    "    return False"
   ]
  }
