   "source": [
    "def minimumBoxes(apple, capacity):\n",
    "    n = sum(apple)\n",
    "    capacity.sort(reverse=True)\n",
    "    temp = 0\n",
    "    for i in range(len(capacity)):\n",
    "        temp += capacity[i]\n",
    "        if n < temp:\n",
    "            return i+1"
   ]
  },
