   "source": [
    "def maxIceCream(costs, coins):\n",
    "    costs.sort()\n",
    "    for i in range(len(costs)):\n",
    "        coins -= costs[i]\n",
    "        if coins < 0:\n",
    "            return i\n",
    "    return len(costs)"
   ]
  },
