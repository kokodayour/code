   "source": [
    "def removeNthFromEnd(head, n):\n",
    "    fast = slow = dummy = ListNode(next= head)\n",
    "    for _ in range(n):\n",
    "        fast = fast.next\n",
    "    while fast.next:\n",
    "        fast = fast.next\n",
    "        slow = slow.next\n",
    "    slow.next = slow.next.next\n",
    "    return dummy.next"
   ]
  }
 ],
