   "source": [
    "def deleteDuplicates(head):\n",
    "    if head is None:\n",
    "        return \n",
    "    pre = head\n",
    "    while pre.next:\n",
    "        if pre.next.val == pre.val:\n",
    "            pre.next = pre.next.next\n",
    "        else:\n",
    "            pre = pre.next\n",
    "    return head"
   ]
  }
 ],
