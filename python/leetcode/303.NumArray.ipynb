   "source": [
    "from itertools import accumulate\n",
    "\n",
    "class NumArray:\n",
    "\n",
    "    def __init__(self, nums: list[int]):\n",
    "        self.s = list(accumulate(nums, initial=0))\n",
    "        \n",
    "\n",
    "    def sumRange(self, left: int, right: int) -> int:\n",
    "        return self.s[right + 1] - self.s[left]"
   ]
  }
