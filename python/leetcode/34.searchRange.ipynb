   "source": [
    "import bisect\n",
    "\n",
    "def searchRange(nums, target: int):\n",
    "    L = bisect.bisect_left(nums, target)\n",
    "    if L == len(nums) or nums[L] != target:\n",
    "        return [-1,-1]\n",
    "    R = bisect.bisect_right(nums, target)\n",
    "    return [L, R-1]"
   ]
  }
