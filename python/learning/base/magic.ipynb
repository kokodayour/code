   "outputs": [],
   "source": [
    "# 当一个类定义了__call__方法时 它的类实例就变成了可调用对象 可以像函数一样使用()调用\n",
    "class Adder():\n",
    "    def __init__(self, nums):\n",
    "        self.nums = nums\n",
    "    def __call__(self, nums):\n",
    "        return self.nums + nums\n",
    "    \n",
    "a = Adder(5)\n",
    "a(5) # 直接将a当作方法一样调用"
   ]
  }
 ],
