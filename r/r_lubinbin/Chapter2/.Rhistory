getwd()
###2.2.1读入基础数据
cp<-read_delim("/data/comp.csv")
cp.csv<-read_csv("/data/comp.csv")
###2.2.1读入基础数据
cp<-read_delim("data/comp.csv")
View(cp)
cp.csv<-read_csv("data/comp.csv")
summary(cp.csv)
spec(cp.csv)
##写入基础数据
#创建包含多列的数据框
df <- data.frame(
x <- c(1, NA, 2, 3, NA),
y <- c("A", "B", "C", NA, "D"),
z <- c(TRUE, FALSE, TRUE, TRUE, NA)
)
View(df)
#将数据框写入文本文件 "df.txt"，缺失值用 "*" 表示，分隔符为逗号
write_delim(df, "df.txt", na = "*", delim = ",")
#将数据框写入 CSV 文件
write_csv(df, "df.csv")
